    "allergens": "soy, gluten, sesame",
    "ingredients": [
      "1½ cups maida (all-purpose flour)",
      "½ cup rice flour",
      "1½ cups ice-cold water",
      "1 tsp salt",
      "2 cups spring onion (cut into 5 cm lengths)",
      "1 carrot (julienned)",
      "1 capsicum (julienned)",
      "4 tbsp oil",
      "2 tbsp soy sauce (for dipping)",
      "1 tbsp rice vinegar (for dipping)",
      "1 tsp sesame seeds (for dipping)"
    ],
    "preparation": [
      "Whisk maida, rice flour, salt and ice-cold water into a thin batter — cold batter makes it crisp.",
      "Heat 2 tbsp oil in a wide pan; lay the spring onion, carrot and capsicum flat.",
      "Pour batter over to just cover; cook 4–5 minutes until the base is golden and lacy.",
      "Flip, add the remaining oil around the edge, cook 3 minutes more.",
      "Cut into squares; serve with soy sauce, vinegar and sesame."
    ]
